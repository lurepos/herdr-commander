{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: check",
      "type": "shell",
      "command": "cargo check",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cargo: test",
      "type": "shell",
      "command": "cargo test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cargo: build --release",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Verify project",
      "dependsOn": [
        "cargo: check",
        "cargo: test"
      ],
      "dependsOrder": "parallel",
      "group": "build"
    }
  ]
}
